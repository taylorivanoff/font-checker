{
  "name": "font-checker",
  "description": "Desktop app and CLI to detect webpage fonts and convert WOFF2 to OTF",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.9",
  "repository": "https://github.com/taylorivanoff/font-checker",
  "type": "module",
  "main": "main/main.js",
  "bin": {
    "font-checker": "./src/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "check": "node src/cli.js",
    "bump": "node scripts/bump-version.cjs",
    "release": "node scripts/minify-release.cjs && electron-builder --project .release-staging --publish=never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "minify:release": "node scripts/minify-release.cjs"
  },
  "build": {
    "appId": "io.github.taylorivanoff.font-checker",
    "productName": "Font Checker",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "resources/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/taylorivanoff/font-checker/releases/latest/download"
    },
    "compression": "maximum"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-tray-base": "github:taylorivanoff/electron-tray-base",
    "electron-updater": "^6.8.9",
    "fonteditor-core": "^2.6.3",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "globals": "^16.0.0",
    "esbuild": "^0.25.0"
  }
}
