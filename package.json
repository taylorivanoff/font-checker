{
  "name": "font-checker",
  "description": "Desktop app and CLI to detect webpage fonts and convert WOFF2 to OTF",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.12",
  "repository": "https://github.com/taylorivanoff/font-checker",
  "type": "module",
  "bin": {
    "font-checker": "./src/cli.js"
  },
  "scripts": {
    "dev": "node scripts/run-tauri.cjs dev",
    "start": "node scripts/run-tauri.cjs dev",
    "build": "node scripts/run-tauri.cjs build",
    "tauri": "node scripts/run-tauri.cjs",
    "release": "node scripts/run-tauri.cjs build",
    "cli": "node src/cli.js",
    "check": "node src/cli.js",
    "bump": "node scripts/bump-version.cjs",
    "icon": "node scripts/run-tauri.cjs icon resources/icon.png",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/sync-shared-styles.cjs",
    "sync:styles": "node scripts/sync-shared-styles.cjs",
    "predev": "node scripts/sync-shared-styles.cjs",
    "prebuild": "node scripts/sync-shared-styles.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fonteditor-core": "^2.6.3",
    "wawoff2": "^2.0.1",
    "@taylorivanoff/shared-styles": "file:../shared-styles"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "globals": "^16.0.0"
  }
}
