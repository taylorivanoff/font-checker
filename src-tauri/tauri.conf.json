{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Font Checker",
  "version": "1.0.13",
  "identifier": "io.github.taylorivanoff.font-checker",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Font Checker",
        "width": 760,
        "height": 620,
        "minWidth": 460,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer.nsi",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjMzMEMzREEzQjJBMzIKUldReUtqdmF3ekR6d2taaHVETjd3MFA4SFpJMHRieG1WRG5sZHU5aWsrSkJXUFRJSTk4VlFoanIK",
      "endpoints": [
        "https://github.com/taylorivanoff/font-checker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
